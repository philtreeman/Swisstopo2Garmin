# Beschriftung: der Name aus dem Namens-Tag wird zum Label (ohne diese Regel schreibt mkgmap keine Labels)
name=* { name '${name}' }
# swissTLM3D -> Garmin-Linientypen. Darstellung (Farben, Breiten) steht in typ/swisstopo.txt.
tlm_layer=strasse & (tlm_kunst=Treppe | tlm_kunst='Bruecke mit Treppe' | tlm_kunst='Unterfuehrung mit Treppe') [0x10e09 resolution 24]
# Tunnel nach swisstopo-Zeichenerklaerung: gestrichelt statt durchgezogen (je Strassenklasse)
tlm_layer=strasse & tlm_kunst=Tunnel & tlm_type=Autobahn [0x10e10 resolution 18]
tlm_layer=strasse & tlm_kunst=Tunnel & (tlm_type='10m Strasse' | tlm_type='8m Strasse') [0x10e11 resolution 19]
tlm_layer=strasse & tlm_kunst=Tunnel & tlm_type='6m Strasse' [0x10e12 resolution 20]
tlm_layer=strasse & tlm_kunst=Tunnel & (tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung | tlm_type=Dienstzufahrt | tlm_type=Zufahrt | tlm_type=Ausfahrt | tlm_type=Einfahrt) [0x10e13 resolution 22]
tlm_layer=strasse & tlm_kunst=Tunnel & (tlm_type='2m Weg' | tlm_type='1m Weg') [0x10e01 resolution 23]
tlm_layer=bahn & tlm_kunst=Tunnel [0x10e14 resolution 20]
# Bruecken: Strasse mit schwarzem Rand (je Strassenklasse)
tlm_layer=strasse & tlm_kunst=Bruecke & tlm_type=Autobahn [0x10e15 resolution 18]
tlm_layer=strasse & tlm_kunst=Bruecke & (tlm_type='10m Strasse' | tlm_type='8m Strasse') [0x10e16 resolution 19]
tlm_layer=strasse & tlm_kunst=Bruecke & tlm_type='6m Strasse' [0x10e17 resolution 20]
tlm_layer=strasse & tlm_kunst=Bruecke & (tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung | tlm_type=Dienstzufahrt | tlm_type=Zufahrt | tlm_type=Ausfahrt | tlm_type=Einfahrt) [0x10e18 resolution 22]
tlm_layer=strasse & tlm_type=Autobahn [0x01 resolution 18]
tlm_layer=strasse & (tlm_type='10m Strasse' | tlm_type='8m Strasse') [0x02 resolution 19]
tlm_layer=strasse & tlm_type='6m Strasse' [0x04 resolution 20]
tlm_layer=strasse & (tlm_type='4m Strasse' | tlm_type='3m Strasse') & tlm_belag=Natur [0x07 resolution 22]
tlm_layer=strasse & (tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung | tlm_type=Dienstzufahrt | tlm_type=Zufahrt | tlm_type=Ausfahrt | tlm_type=Einfahrt) [0x06 resolution 22]
tlm_layer=strasse & tlm_type=Platz [0x06 resolution 23]
# Wege nach swisstopo-Zeichenerklaerung (Wanderwege sind im Overlay, hier nicht farbig codiert)
tlm_layer=strasse & tlm_type='2m Weg' [0x0a resolution 23]
tlm_layer=strasse & tlm_type='1m Weg' [0x10e01 resolution 23]
tlm_layer=strasse & tlm_type='Markierte Spur' [0x10e08 resolution 23]
tlm_layer=bahn & tlm_type=Normalspur [0x14 resolution 20]
tlm_layer=bahn [0x14 resolution 22]
tlm_layer=ubahn [0x10e02 resolution 23]
tlm_layer=fluss & (tlm_type=Fliessgewaesser) & tlm_stufe=0 [0x18 resolution 21]
tlm_layer=fluss & tlm_type=Trockenrinne [0x10e03 resolution 23]
tlm_layer=mauer [0x10e04 resolution 24]
# Verbauungen: Schutzverbauung (Lawinen, Steinschlag) braun, Trockenmauer grau
tlm_layer=verbauung & tlm_type=Schutzverbauung [0x10e06 resolution 24]
tlm_layer=verbauung & tlm_type=Trockenmauer [0x10e04 resolution 24]
# Grenzen (nur Variante edge; swissBOUNDARIES3D)
tlm_layer=grenze & tlm_type=Landesgrenze [0x10e0a resolution 18]
tlm_layer=grenze & tlm_type=Kantonsgrenze [0x10e0b resolution 20]
tlm_layer=grenze & tlm_type=Gemeindegrenze [0x10e0c resolution 23]
