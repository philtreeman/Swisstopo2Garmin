# Beschriftung: der Name aus dem Namens-Tag wird zum Label (ohne diese Regel schreibt mkgmap keine Labels)
name=* { name '${name}' }
# Routing (nur mit --style-option=routing=1): Strassenklassen, Zugang, Einbahn; ohne die Option bleibt alles wie bisher
if (mkgmap:option:routing=1) then
include "inc/routing_lines";
end
# swissTLM3D -> Garmin-Linientypen. Darstellung (Farben, Breiten) steht in typ/swisstopo.txt.
tlm_layer=bahnuebergang [0x10e19 resolution 22]
tlm_layer=strasse & (tlm_kunst=Treppe | tlm_kunst='Bruecke mit Treppe' | tlm_kunst='Unterfuehrung mit Treppe') [0x10e09 resolution 22]
# Strassen nach der swisstopo-Zeichenerklaerung (Landeskarten 1:25 000): Farbe nach Verkehrsbedeutung (tlm_vbed = VERKEHRSBD),
# nicht nach Breite. Autobahn und Autostrasse orange (0x01), Durchgangsstrasse rosa (0x02), Verbindungsstrasse gelb (0x03),
# uebrige Strassen weiss mit schwarzem Rand (0x04 6 m, 0x05 8/10 m, 0x06 4/3 m, 0x07 Naturbelag). Hochleistungsstrasse = Autobahn,
# Autostrasse, Ein-/Ausfahrt. Tunnel sind immer schwarz gestrichelt ohne Farbe, ob Durchgangs- oder Verbindungsstrasse.
# Bruecken und Galerien bekommen die Farbe der Verkehrsbedeutung.
# Tunnel (je Strassenklasse nur die Breite)
tlm_layer=strasse & tlm_kunst=Tunnel & tlm_type=Autobahn [0x10e10 resolution 18]
tlm_layer=strasse & tlm_kunst=Tunnel & tlm_type=Autostrasse [0x10e10 resolution 19]
tlm_layer=strasse & tlm_kunst=Tunnel & (tlm_type='10m Strasse' | tlm_type='8m Strasse') [0x10e11 resolution 19]
tlm_layer=strasse & tlm_kunst=Tunnel & tlm_type='6m Strasse' [0x10e12 resolution 20]
tlm_layer=strasse & tlm_kunst=Tunnel & (tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung | tlm_type=Dienstzufahrt | tlm_type=Zufahrt | tlm_type=Ausfahrt | tlm_type=Einfahrt) [0x10e13 resolution 22]
tlm_layer=strasse & tlm_kunst=Tunnel & ((tlm_type='2m Weg' | tlm_type='2m Wegfragment') | (tlm_type='1m Weg' | tlm_type='1m Wegfragment')) [0x10e01 resolution 22]
tlm_layer=bahn & tlm_kunst=Tunnel [0x10e14 resolution 20]
# Galerien und gedeckte Bruecken (Strassen; Wege bleiben normale Wege): Strassenfarbe mit Querstrichen
tlm_layer=strasse & (tlm_kunst=Galerie | tlm_kunst='Bruecke mit Galerie' | tlm_kunst='Gedeckte Bruecke') & (tlm_type=Autobahn | tlm_type=Autostrasse) [0x10e1f resolution 18]
tlm_layer=strasse & (tlm_kunst=Galerie | tlm_kunst='Bruecke mit Galerie' | tlm_kunst='Gedeckte Bruecke') & tlm_vbed=Durchgangsstrasse & (tlm_type='10m Strasse' | tlm_type='8m Strasse' | tlm_type='6m Strasse' | tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung) [0x10e1c resolution 19]
tlm_layer=strasse & (tlm_kunst=Galerie | tlm_kunst='Bruecke mit Galerie' | tlm_kunst='Gedeckte Bruecke') & tlm_vbed=Verbindungsstrasse & (tlm_type='10m Strasse' | tlm_type='8m Strasse' | tlm_type='6m Strasse' | tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung) [0x10e1d resolution 20]
tlm_layer=strasse & (tlm_kunst=Galerie | tlm_kunst='Bruecke mit Galerie' | tlm_kunst='Gedeckte Bruecke') & (tlm_type='10m Strasse' | tlm_type='8m Strasse') [0x10e1e resolution 19]
tlm_layer=strasse & (tlm_kunst=Galerie | tlm_kunst='Bruecke mit Galerie' | tlm_kunst='Gedeckte Bruecke') & tlm_type='6m Strasse' [0x10e1e resolution 20]
tlm_layer=strasse & (tlm_kunst=Galerie | tlm_kunst='Bruecke mit Galerie' | tlm_kunst='Gedeckte Bruecke') & (tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung | tlm_type=Dienstzufahrt | tlm_type=Zufahrt | tlm_type=Ausfahrt | tlm_type=Einfahrt) [0x10e1e resolution 22]
# Bruecken: Strasse mit schwarzem Rand, Farbe nach Verkehrsbedeutung
tlm_layer=strasse & tlm_kunst=Bruecke & (tlm_type=Autobahn | tlm_type=Autostrasse) [0x10e15 resolution 18]
tlm_layer=strasse & tlm_kunst=Bruecke & tlm_vbed=Durchgangsstrasse & (tlm_type='10m Strasse' | tlm_type='8m Strasse' | tlm_type='6m Strasse' | tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung) [0x10e1a resolution 19]
tlm_layer=strasse & tlm_kunst=Bruecke & tlm_vbed=Verbindungsstrasse & (tlm_type='10m Strasse' | tlm_type='8m Strasse' | tlm_type='6m Strasse' | tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung) [0x10e1b resolution 20]
tlm_layer=strasse & tlm_kunst=Bruecke & (tlm_type='10m Strasse' | tlm_type='8m Strasse') [0x10e16 resolution 19]
tlm_layer=strasse & tlm_kunst=Bruecke & tlm_type='6m Strasse' [0x10e17 resolution 20]
tlm_layer=strasse & tlm_kunst=Bruecke & (tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung | tlm_type=Dienstzufahrt | tlm_type=Zufahrt | tlm_type=Ausfahrt | tlm_type=Einfahrt) [0x10e18 resolution 22]
# Steg: durchgezogene feine Linie (Zeichenerklaerung: 1 m-Weg, Steg)
tlm_layer=strasse & tlm_kunst=Steg [0x0b resolution 22]
tlm_layer=strasse & tlm_type=Autobahn [0x01 resolution 18]
tlm_layer=strasse & tlm_type=Autostrasse [0x01 resolution 19]
tlm_layer=strasse & tlm_vbed=Durchgangsstrasse & (tlm_type='10m Strasse' | tlm_type='8m Strasse' | tlm_type='6m Strasse' | tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung) [0x02 resolution 19]
tlm_layer=strasse & tlm_vbed=Verbindungsstrasse & (tlm_type='10m Strasse' | tlm_type='8m Strasse' | tlm_type='6m Strasse' | tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung) [0x03 resolution 20]
tlm_layer=strasse & (tlm_type='10m Strasse' | tlm_type='8m Strasse') [0x05 resolution 19]
tlm_layer=strasse & tlm_type='6m Strasse' [0x04 resolution 20]
tlm_layer=strasse & (tlm_type='4m Strasse' | tlm_type='3m Strasse') & tlm_belag=Natur [0x07 resolution 22]
tlm_layer=strasse & (tlm_type='4m Strasse' | tlm_type='3m Strasse' | tlm_type=Verbindung | tlm_type=Dienstzufahrt | tlm_type=Zufahrt | tlm_type=Ausfahrt | tlm_type=Einfahrt) [0x06 resolution 22]
tlm_layer=strasse & tlm_type=Platz [0x06 resolution 22]
# Wege nach swisstopo-Zeichenerklaerung (Wanderwege sind im Overlay, hier nicht farbig codiert)
# 2 m-Weg: Hartbelag feine Doppellinie (0x0a), Naturbelag feine Volllinie (0x0b)
tlm_layer=strasse & (tlm_type='2m Weg' | tlm_type='2m Wegfragment') & tlm_belag=Natur [0x0b resolution 22]
tlm_layer=strasse & (tlm_type='2m Weg' | tlm_type='2m Wegfragment') [0x0a resolution 22]
tlm_layer=strasse & (tlm_type='1m Weg' | tlm_type='1m Wegfragment') [0x10e01 resolution 22]
tlm_layer=strasse & tlm_type='Markierte Spur' [0x10e08 resolution 22]
tlm_layer=strasse & tlm_type=Klettersteig [0x10e00 resolution 22]
tlm_layer=bahn & tlm_type=Normalspur [0x14 resolution 20]
tlm_layer=bahn [0x14 resolution 22]
tlm_layer=ubahn [0x10e02 resolution 22]
tlm_layer=fluss & (tlm_type=Fliessgewaesser) & tlm_stufe=0 [0x18 resolution 21]
tlm_layer=fluss & tlm_type=Trockenrinne [0x10e03 resolution 22]
tlm_layer=mauer [0x10e04 resolution 22]
# Verbauungen: Schutzverbauung (Lawinen, Steinschlag) braun, Trockenmauer grau
tlm_layer=verbauung & tlm_type=Schutzverbauung [0x10e06 resolution 22]
tlm_layer=verbauung & tlm_type=Trockenmauer [0x10e04 resolution 22]
# Grenzen (nur Variante edge; swissBOUNDARIES3D)
tlm_layer=grenze & tlm_type=Landesgrenze [0x10e0a resolution 18]
tlm_layer=grenze & tlm_type=Kantonsgrenze [0x10e0b resolution 20]
tlm_layer=grenze & tlm_type=Gemeindegrenze [0x10e0c resolution 22]
