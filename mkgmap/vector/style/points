# Beschriftung: der Name aus dem Namens-Tag wird zum Label (ohne diese Regel schreibt mkgmap keine Labels)
name=* { name '${name}' }
# Gipfel, Huegel, Paesse mit Hoehe: schwarzes Kreuz (Hoehenkote der Zeichenerklaerung); in Fenix steht nur die Hoehe als Name
tlm_layer=namepkt & (tlm_type=Hauptgipfel | tlm_type=Gipfel | tlm_type='Alpiner Gipfel' | tlm_type=Felskopf) [0x6616 resolution 22]
tlm_layer=namepkt & (tlm_type=Haupthuegel | tlm_type=Huegel) [0x6616 resolution 22]
tlm_layer=namepkt & (tlm_type=Pass | tlm_type=Strassenpass) [0x6615 resolution 22]
# Einzelbaeume (nur mit --trees im Konverter; Fenix: nur in der feinsten Stufe, ausgeduennt wie im Edge)
tlm_layer=baum [0x10f00 resolution 24]
# alles Weitere nur in der Variante Edge (build_vector.sh setzt --style-option=variant=edge bzw. fenix)
if (mkgmap:option:variant=edge) then
include "inc/points_edge";
end
