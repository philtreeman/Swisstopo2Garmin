# Beschriftung: der Name aus dem Namens-Tag wird zum Label (ohne diese Regel schreibt mkgmap keine Labels)
name=* { name '${name}' }
tlm_layer=bb & (tlm_type=Wald | tlm_type='Wald offen' | tlm_type=Gebueschwald) [0x50 resolution 20]
tlm_layer=bb & tlm_type=Gehoelzflaeche [0x4f resolution 22]
tlm_layer=bb & (tlm_type=Fels | tlm_type='Fels locker') [0x52 resolution 21]
tlm_layer=bb & tlm_type=Lockergestein [0x53 resolution 21]
tlm_layer=bb & tlm_type=Feuchtgebiet [0x51 resolution 22]
tlm_layer=bb & (tlm_type='Stehende Gewaesser' | tlm_type=Fliessgewaesser) [0x3f resolution 20]
tlm_layer=see & tlm_type=See [0x3f resolution 20]
tlm_layer=see & tlm_type=Seeinsel [0x4e resolution 22]
tlm_layer=areal & tlm_type=Reben [0x4e resolution 22]
tlm_layer=areal & tlm_type=Obstanlage [0x10e08 resolution 22]
tlm_layer=areal & tlm_type=Baumschule [0x10e09 resolution 22]
tlm_layer=areal & tlm_type=Friedhof [0x1a resolution 22]
tlm_layer=areal & tlm_type='Oeffentliches Parkareal' [0x17 resolution 22]
tlm_layer=areal [0x0c resolution 22]
tlm_layer=vareal [0x0e resolution 22]
tlm_layer=gebaeude & (tlm_type=Gebaeude | tlm_type=Hochhaus | tlm_type='Sakrales Gebaeude' | tlm_type='Offenes Gebaeude' | tlm_type=Flugdach | tlm_type=Treibhaus) [0x10e05 resolution 22]
# abgeleitet aus Gebaeuden (scripts/vector2mkgmap.py): grauer Untergrund unter Siedlungen
tlm_layer=siedlung [0x01 resolution 21]
# Sport-, Freizeit- und Erholungsflaechen
tlm_layer=freizeit & tlm_type=Sportplatzareal [0x10e07 resolution 22]
tlm_layer=freizeit [0x19 resolution 22]
