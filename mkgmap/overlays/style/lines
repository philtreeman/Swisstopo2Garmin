# Wanderwege: schwarz, Linienart nach Wegtyp (swisstopo-Zeichenerklaerung): 2 m-Weg durchgezogen, 1 m-Weg gestrichelt,
# markierte Spur punktiert, Wanderwege auf Strassen als duenne Mittellinie
route_layer=wanderwege & route_class=weg2 [0x10f00 resolution 22]
route_layer=wanderwege & route_class=weg1 [0x10f01 resolution 22]
route_layer=wanderwege & route_class=spur [0x10f02 resolution 22]
route_layer=wanderwege & route_class=strasse [0x10f0d resolution 22]
route_layer=wanderland & route_class=national [0x10f03 resolution 18]
route_layer=wanderland & route_class=regional [0x10f04 resolution 20]
route_layer=wanderland & route_class=handicap [0x10f06 resolution 21]
route_layer=wanderland [0x10f05 resolution 21]
route_layer=veloland & route_class=national [0x10f07 resolution 18]
route_layer=veloland & route_class=regional [0x10f08 resolution 20]
route_layer=veloland [0x10f09 resolution 21]
route_layer=mtb & route_class=national [0x10f0a resolution 18]
route_layer=mtb & route_class=regional [0x10f0b resolution 20]
route_layer=mtb [0x10f0c resolution 21]
route_layer=ski & route_class=4 [0x11004 resolution 20]
route_layer=ski & route_class=3 [0x11003 resolution 20]
route_layer=ski & route_class=2 [0x11002 resolution 20]
route_layer=ski & route_class=1 [0x11001 resolution 20]
route_layer=ski [0x11000 resolution 21]
# Hoehenlinien (swissALTI3D). Zwei Karten: 20 m (contour=20 und 100) und 10 m (contour=10, 50, 100); je Karte eigenes TYP.
# Erweiterte Typen wie bei den Routen-Overlays (die Standardtypen 0x20-0x22 zeigte der Edge nicht).
contour=100 { name '${ele}' } [0x10f11 resolution 20]
contour=50 { name '${ele}' } [0x10f12 resolution 21]
contour=20 [0x10f10 resolution 22]
contour=10 [0x10f10 resolution 23]
